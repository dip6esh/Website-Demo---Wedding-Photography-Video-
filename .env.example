# Supabase — required for contact form submission and any DB features.
# Whitelabel / resale: replace these three values per client/deploy.
#   URL + Anon Key go to the browser (public).
#   Service Role Key lives ONLY on the server (never ship to browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key-here
